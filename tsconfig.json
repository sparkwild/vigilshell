{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@contracts": ["./src/contracts/index.ts"],
      "@contracts/*": ["./src/contracts/*"]
    },
    "allowJs": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
