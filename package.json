{
  "name": "vigilshell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "npm run prepare:dev && node scripts/dev-backend.mjs && electron-vite dev",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "node scripts/check-rust-toolchain.mjs && npm run deps:check && npm run foundation:check && npm run boundaries:check && npm run lint && npm run format:check && npm run ui:check && npm run contracts:check && npm run i18n:check && npm run typecheck && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run backend:build && npm run test:signing && vitest run && cargo test --workspace",
    "build": "node scripts/dev-preflight.mjs --process-only && npm run backend:build -- --release && npm run contracts:generate && npm run i18n:generate && node scripts/build-notification-bridge.mjs && electron-vite build",
    "package": "node scripts/package-macos.mjs",
    "test:e2e": "node tests/e2e/dev-smoke.mjs",
    "dev:app": "npm run prepare:dev && node scripts/dev-app.mjs",
    "test:dev-app": "node tests/development/dev-app.mjs",
    "test:dev-session": "node --test tests/development/dev-session.test.mjs",
    "test:mcp-discovery": "node --test tests/development/mcp-discovery.test.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "postinstall": "install-electron",
    "deps:check": "node scripts/check-dependencies.mjs",
    "test:packaged": "node scripts/test-packaged.mjs",
    "backend:check": "node scripts/check-backend.mjs",
    "deps:rust": "node scripts/check-rust-dependencies.mjs",
    "test:configuration": "vitest run src/renderer/features/connections/model/use-connection-editor.test.tsx src/renderer/features/connections/proxies/ProxyOptions.test.tsx src/shared/workspace-validation.test.ts",
    "test:configuration:network": "cargo test --locked -p vigilshell-transport-russh --test routes",
    "test:connections": "vitest run src/renderer/features/connections src/renderer/features/terminal",
    "test:sidebar": "vitest run src/renderer/features/connections/navigation.test.ts src/renderer/features/connections/group-layout.test.ts src/renderer/features/connections/model/read-pages.test.ts src/renderer/features/connections/workspace-store.test.ts",
    "test:sidebar:ssh": "cargo test --locked -p vigilshell-application --lib real_ssh_session_survives_layout_removal_and_environment_save",
    "test:async-feedback": "vitest run src/renderer/features/connections/operations.test.ts src/renderer/features/connections/model/use-connection-editor.test.tsx src/renderer/features/connections/connection-feedback.test.tsx src/renderer/features/settings/SettingsView.test.tsx src/renderer/features/notifications/feedback-store.test.ts src/renderer/features/notifications/transfer-feedback-runtime.test.ts",
    "ui:check": "node scripts/check-ui.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "signing:configure": "node scripts/signing-config.mjs",
    "signing:check": "node scripts/signing-config.mjs --check",
    "test:signing": "node --test tests/development/signing*.test.mjs",
    "signing:verify": "node scripts/verify-signing.mjs",
    "prepare:dev": "node scripts/dev-preflight.mjs && npm run backend:build && npm run contracts:generate && npm run i18n:generate && node scripts/build-notification-bridge.mjs",
    "typecheck": "npm run i18n:generate && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "i18n:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/i18n/generated --strategy globalVariable baseLocale",
    "backend:build": "node scripts/build-backend.mjs",
    "foundation:check": "node scripts/check-foundation.mjs",
    "package:dev": "node scripts/package-macos.mjs --profile dev --dir",
    "package:release": "node scripts/package-macos.mjs --profile release",
    "lint": "eslint .",
    "test:foundation": "node scripts/test-foundation.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.json\" \"*.mjs\" \"*.ts\" \".github/**/*.yml\" \"tests/**/*.{ts,tsx,mjs}\"",
    "test:icons": "node --test tests/development/icons.test.mjs",
    "dev:migrate-agent-policy": "node scripts/migrate-agent-policy.mjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.25.1",
    "@modelcontextprotocol/client": "2.2.0",
    "@swc/core": "1.16.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv-formats": "2.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "3.1.0"
    },
    "zod@3.24.1": "3.25.76"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core": false,
    "electron-winstaller": false,
    "fsevents": false
  },
  "main": "out/main/index.js",
  "description": "VigilShell desktop foundation",
  "author": "sparkwild",
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@noble/hashes": "2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.4"
  }
}
